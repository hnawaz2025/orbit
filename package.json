{
  "name": "orbit",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:app": "npm run start --workspace app",
    "ingest": "npm run ingest --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run build --workspace @orbit/shared && npm run typecheck --workspace server",
    "build:shared": "npm run build --workspace @orbit/shared"
  },
  "engines": {
    "node": "22.x"
  }
}
