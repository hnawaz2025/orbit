# Copy to .env and fill in. Values here are the safe defaults; the two blank
# keys are secrets and have no default.

DATABASE_URL="postgresql://user@localhost:5432/orbit"
PORT=4001  # 4000 is Leena's dev server on this machine

AI_LLM_PROVIDER=featherless
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
# Chosen by bake-off against one chunk of the API World schedule page
# (2026-08-27). Qwen2.5-7B: 58s, 18 entities, 18/18 on location, speaker and
# tags. phi-4 and Qwen2.5-14B found 2 more entities each but took ~95s and
# dropped 2 speakers. Mistral-Nemo wrote "// ... (rest omitted)" inside its
# JSON; gemma-3-12b is gated; DeepSeek-V3-0324 costs 4 concurrency units
# against a plan ceiling of 4, so it serves exactly one request at a time --
# a 429 for the second person to open the app during a demo.
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=text-embedding-3-small

# Reads the question and writes the reasons -- the two things the product is
# actually made of. Separate from FEATHERLESS_MODEL, which now only does batch
# extraction for the sponsors page, since sessions come from Sessionize.
REASONING_MODEL=gpt-5.4-mini

# Gate on the organiser view. The endpoint refuses without it, so forgetting to
# set it locks the door rather than publishing every question attendees asked.
ORGANIZER_TOKEN=orbit-demo-2026

# Optional. Absent means ingest skips enrichment rather than failing (P2).
# SERPAPI_API_KEY=
